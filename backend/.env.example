# ── Copy this file to .env and fill in your values ──────────
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows CMD)

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── Auth ─────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here

# ── Database (Production / Render) ───────────────────────────
# Leave blank for local SQLite. Set to your PostgreSQL URL on Render.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Cloudinary (Media Uploads) ───────────────────────────────
# Required for photo/video uploads. Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Gemini AI (optional) ──────────────────────────────────────
# Get yours from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
