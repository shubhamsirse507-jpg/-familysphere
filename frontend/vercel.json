{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://familysphere-uf95.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://familysphere-uf95.onrender.com/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://familysphere-uf95.onrender.com/uploads/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://familysphere-uf95.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://familysphere-uf95.onrender.com/admin/:path*"
    },
    {
      "source": "/((?!api|socket.io|uploads|admin|assets|favicon.ico|logo.png).*)",
      "destination": "/index.html"
    }
  ]
}
